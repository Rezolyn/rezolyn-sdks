# Widget build-time config. The widget is compiled and served from a CDN, so
# its default API URL is baked in at build time from VITE_API_URL. A page can
# still override per-embed with data-api-url. Moving domains = rebuild with a
# different value here, not a source edit.
VITE_API_URL=https://api.lingohq.xyz

# The Zendesk and Freshdesk apps take their API URL from each customer's
# secure app settings at install time (default: https://api.lingohq.io) — no
# .env needed for those.
